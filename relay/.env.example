PORT=8787
# kuruma bot과 같은 키 (~/translate-bot/.env 에서 복사)
DEEPL_API_KEY=
# 접속 토큰. "이름:토큰" 형식, 여러 개면 쉼표로 구분
# 예) RELAY_TOKENS=cha:aaaa...,friends:bbbb...
RELAY_TOKENS=
# 토큰 하나가 하루(일본 시간 기준)에 번역할 수 있는 최대 글자 수 (0 = 제한 없음)
DAILY_LIMIT_PER_TOKEN=30000
# 봇 몫으로 남겨둘 글자 수. 월 사용량이 (한도 - 이 값)에 도달하면 릴레이는 번역을 멈춤
RESERVE_CHARS=100000

